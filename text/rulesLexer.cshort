/*
================================================================================

REGRAS LEXICAS 

letra ::= a | b | ... | z | A | B | ... | Z

digito ::= 0 | 1 | ... | 9

id ::= letra { letra | digito | _ }

intcon ::= digito { digito }

realcon ::= intcon.intcon

charcon ::= 'ch' | '\n' | '\0', onde ch denota qualquer caractere imprimível da tabela
ASCII, como especificado pela função isprint() do C, diferente de \ (barra
invertida) e ' (apóstrofo).

stringcon ::= "{ch}", onde ch denota qualquer caractere imprimível da tabela ASCII,
como especificado pela função isprint() do C, diferente de " (aspas) e do
caractere newline.

comentario Comentários são como no C, i.e. uma sequência de caracteres precedida
por /* e seguida por */, que não contém nenhuma ocorrência de */. 

/*
================================================================================